# Content of the service-account JSON key (raw JSON or base64). Alternatively GOOGLE_APPLICATION_CREDENTIALS=/path/key.json
GOOGLE_CREDENTIALS_JSON=
# Required for HTTP mode: long random string, e.g. `openssl rand -hex 32`
MCP_AUTH_TOKEN=
# Optional
GOOGLE_PLAY_PACKAGE_NAME=
PLAY_DEVELOPER_ID=
MCP_READ_ONLY=false
